---
import Navbar from "@/components/nav/Navbar.astro";
import Socials from "@/components/nav/Socials.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import Section from "@/components/Section.astro";
import ExperienceTimeline from "@/components/ExperienceTimeline.astro";
import { getLangFromUrl } from "@/i18n/utils";
import Layout from "@/layouts/Layout.astro";

import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";

const lang = getLangFromUrl(Astro.url);

const featuredProjects = await getCollection(
  "projects",
  ({ data }: { data: { published: boolean } }) => {
    return data.published;
  },
);

const orderedProjects = [...featuredProjects]
  .sort(
    (a: CollectionEntry<"projects">, b: CollectionEntry<"projects">) =>
      a.data.order - b.data.order,
  )
  .filter((project) => project.slug.startsWith(lang));

const experiences = (await getCollection("experience"))
  .filter((e: CollectionEntry<"experience">) => e.slug.startsWith(lang))
  .sort(
    (a: CollectionEntry<"experience">, b: CollectionEntry<"experience">) =>
      a.data.order - b.data.order,
  );
---

<Layout
  title="Abdulhamit Celik"
  description="Yapay zeka destekli ve ölçeklenebilir ürünler geliştiriyorum. Şu an Tayvan'da, küresel fırsatlara açığım."
>
  <Navbar />
  <div class="mt-6 space-y-6">
    <img
      src="/me.webp"
      alt="Abdulhamit Celik"
      class="w-24 h-24 rounded-full sm:w-32 sm:h-32"
    />
    <h1 class="text-3xl font-bold sm:text-4xl md:text-5xl">Abdulhamit Celik</h1>
  </div>

  <div class="mt-10 mb-6">
    <p class="mb-5 text-neutral-300">
      Yapay zeka destekli ve ölçeklenebilir ürünler geliştiriyorum. Şu an
      Tayvan&apos;da, küresel fırsatlara açığım.
    </p>
  </div>

  <div class="mb-12">
    <Socials />
  </div>

  <Section title="Deneyim">
    <ExperienceTimeline experiences={experiences} />
  </Section>

  <Section title="Projeler">
    <div class="flex flex-col gap-5">
      {orderedProjects.map((project) => <ProjectCard project={project} />)}
    </div>
  </Section>
</Layout>
